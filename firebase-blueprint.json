{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or Admin campus profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "campusId": { "type": "string", "maxLength": 50 },
        "department": { "type": "string", "maxLength": 100 },
        "dormOrBuilding": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 500 },
        "trustScore": { "type": "number" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "isVerified": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "displayName", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Whitelisted administrator credentials",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255 },
        "addedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Item": {
      "title": "Item",
      "description": "Lost, found, lent, or borrow-requested item listing",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["lost", "found", "lend", "borrow_request"] },
        "title": { "type": "string", "maxLength": 120, "minLength": 2 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "enum": ["electronics", "books", "clothing", "id_cards", "keys", "accessories", "sports", "lab_equipment", "other"] },
        "location": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 500000 },
        "status": { "type": "string", "enum": ["open", "pending", "claimed", "borrowed", "returned", "closed"] },
        "userId": { "type": "string", "maxLength": 128 },
        "userDisplayName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 255 },
        "userPhotoURL": { "type": "string", "maxLength": 2048 },
        "userCampusId": { "type": "string", "maxLength": 50 },
        "securityQuestion": { "type": "string", "maxLength": 250 },
        "reward": { "type": "string", "maxLength": 100 },
        "pickupLocation": { "type": "string", "maxLength": 150 },
        "borrowDurationDays": { "type": "number" },
        "currentBorrowerId": { "type": "string", "maxLength": 128 },
        "currentBorrowerName": { "type": "string", "maxLength": 100 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "flagsCount": { "type": "number" },
        "isFlagged": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["type", "title", "description", "category", "location", "status", "userId"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Claim or borrow request submission for an item",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "itemTitle": { "type": "string", "maxLength": 120 },
        "itemType": { "type": "string", "enum": ["lost", "found", "lend", "borrow_request"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "claimantId": { "type": "string", "maxLength": 128 },
        "claimantName": { "type": "string", "maxLength": 100 },
        "claimantEmail": { "type": "string", "maxLength": 255 },
        "claimantPhotoURL": { "type": "string", "maxLength": 2048 },
        "claimantDepartment": { "type": "string", "maxLength": 100 },
        "proofOrReason": { "type": "string", "maxLength": 1500 },
        "borrowDates": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "returned", "cancelled"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["itemId", "itemTitle", "itemType", "ownerId", "claimantId", "status", "proofOrReason"]
    },
    "Message": {
      "title": "Message",
      "description": "Safe inquiry message regarding an item",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhotoURL": { "type": "string", "maxLength": 2048 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 1000, "minLength": 1 },
        "createdAt": { "type": "string" }
      },
      "required": ["itemId", "senderId", "senderName", "recipientId", "text"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Campus lost/found and community broadcast announcement",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 1000 },
        "urgency": { "type": "string", "enum": ["info", "warning", "alert"] },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message", "urgency", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles for campus students and admins"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Designated administrator permissions lookup"
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "All campus lost, found, lend, and borrow items"
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/Claim" },
      "description": "Item ownership claims and borrowing requests"
    },
    "/items/{itemId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Item-specific student discussion and inquiries"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Official campus notifications and updates"
    }
  }
}
